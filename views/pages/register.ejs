<div class="auth-container">
  <div class="auth-card">
    <h2>Create Account 🚀</h2>
    <form action="/register" method="POST">
      <div class="mb-3">
        <input type="text" name="username" class="form-control" placeholder="Username" required>
      </div>
      <div class="mb-3">
        <input type="password" name="password" class="form-control" placeholder="Password" required>
      </div>
      <div class="mb-3">
      <label class="form-label">AWS Access Key</label>
      <input type="text" name="aws_access_key" class="form-control" required>
    </div>

    <div class="mb-3">
      <label class="form-label">AWS Secret Key</label>
      <input type="password" name="aws_secret_key" class="form-control" required>
    </div>

    <div class="mb-3">
      <label class="form-label">AWS Region</label>
      <select name="aws_region" class="form-select" required>
        <option value="us-east-1">US East (N. Virginia)</option>
        <option value="eu-north-1">EU (Stockholm)</option>
        <option value="ap-south-1">Asia Pacific (Mumbai)</option>
      </select>
    </div>
      <button type="submit" class="btn btn-success">Register</button>
    </form>
    <p class="mt-3 text-center">
      Already have an account? <a href="/login">Login</a>
    </p>
  </div>
</div>
