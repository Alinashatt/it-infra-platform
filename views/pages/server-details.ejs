<div class="container mt-5">
  <div class="card shadow-sm border-0 p-4">
    <% if (server) { %>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary mb-0"><%= server.name %></h3>
        <span class="badge 
          <% if (server.status === 'running') { %> bg-success 
          <% } else if (server.status === 'provisioning') { %> bg-warning text-dark 
          <% } else if (server.status === 'error') { %> bg-danger 
          <% } else { %> bg-secondary <% } %>">
          <%= server.status %>
        </span>
      </div>

      <table class="table table-bordered align-middle">
        <tbody>
          <tr><th>Instance ID</th><td><%= server.instance_id %></td></tr>
          <tr><th>Type</th><td><%= server.instance_type %></td></tr>
          <tr><th>Region</th><td><%= server.region %></td></tr>
          <tr><th>Storage</th><td><%= server.storage %> GB</td></tr>
          <tr><th>OS</th><td><%= server.os %></td></tr>
          <tr><th>Created At</th><td><%= server.created_at.toLocaleString() %></td></tr>
          <tr><th>Public IP</th><td><%= server.public_ip || 'N/A' %></td></tr>
        </tbody>
      </table>

      <div class="d-flex gap-2 mt-3">
        <a href="/servers/<%= server.id %>/ssh?ip=<%= server.public_ip %>&user=<%= server.os === 'ubuntu' ? 'ubuntu' : 'ec2-user' %>"
           class="btn btn-dark flex-fill" target="_blank">🖥 SSH Access</a>

        <a href="/monitor/<%= server.id %>" class="btn btn-outline-info flex-fill">📈 Monitor</a>

        <form action="/aws/create/<%= server.instance_id %>" method="POST" class="flex-fill">
          <button class="btn btn-outline-warning w-100">💾 Backup</button>
        </form>

        <% if (server.ami_id) { %>
          <form action="/restore/from-ami/<%= server.ami_id %>" method="POST" class="flex-fill">
            <button class="btn btn-outline-success w-100">♻️ Restore</button>
          </form>
        <% } else { %>
          <button class="btn btn-outline-secondary w-100" disabled>♻️ Restore</button>
        <% } %>

        <form
          action="/servers/delete/<%= server.id %>"
          method="POST"
          onsubmit="return confirmDelete()"
          style="display:inline;"
        >
          <button type="submit" class="btn btn-danger mt-3">🗑️ Delete Server</button>
        </form>

        <script>
          function confirmDelete() {
            return confirm("⚠️ Are you sure you want to delete this server? This action cannot be undone!");
          }
        </script>
      </div>

      <div class="text-center mt-4">
        <a href="/" class="btn btn-secondary px-4">⬅ Back to Dashboard</a>
      </div>

    <% } else { %>
      <div class="alert alert-warning">Server not found.</div>
    <% } %>
  </div>
</div>

