<%- include('../partials/header.ejs') %>

<section>
  <h2>Server Details</h2>

  <% if (server) { %>
    <ul>
      <li><strong>Name:</strong> <%= server.name %></li>
      <li><strong>Instance ID:</strong> <%= server.instance_id %></li>
      <li><strong>Type:</strong> <%= server.instance_type %></li>
      <li><strong>Region:</strong> <%= server.region %></li>
      <li><strong>Storage:</strong> <%= server.storage %> GB</li>
      <li><strong>OS:</strong> <%= server.os %></li>
      <li><strong>Status:</strong> <%= server.status %></li>
      <li><strong>Created At:</strong> <%= server.created_at.toLocaleString() %></li>
    </ul>

    <a href="/">⬅ Back to Dashboard</a>
  <% } else { %>
    <p>Server not found.</p>
  <% } %>
    
  <a href="/servers/<%= server.id %>/ssh?ip=<%= server.public_ip %>&user=<%= server.os === 'ubuntu' ? 'ubuntu' : 'ec2-user' %>" 
    class="btn btn-dark mt-3" target="_blank">
    Open SSH Terminal
  </a>
  <!-- delete button-->
  <form action="/servers/delete/<%= server.id %>" method="POST" style="display:inline;">
    <button type="submit">Delete</button>
  </form>

</section>

<%- include('../partials/footer.ejs') %>
