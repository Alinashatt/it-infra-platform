<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>SSH Terminal</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/xterm/css/xterm.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/xterm/lib/xterm.js"></script>
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <style>
      body {
        background: #111;
        margin: 0;
      }
      #terminal {
        height: 100vh;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <div id="terminal"></div>

    <script>
      const socket = io("http://localhost:5001");
      const term = new Terminal();
      term.open(document.getElementById("terminal"));

      const params = new URLSearchParams(window.location.search);
      const host = params.get("ip");
      const username = params.get("user") || "ubuntu";

      
      let cmdBuffer = "";

      
      socket.emit("start-ssh", {
        host,
        username,
        privateKeyPath: "/home/anashat/.ssh/myDeffaultKeyPair.pem",
      });

      
      socket.on("data", (data) => {
        term.write(data);
      });

      term.onKey(e => {
        const key = e.key;
        const domEvent = e.domEvent;

        
        if (domEvent.key === "Enter") {
          term.write("\r\n");              
          socket.emit("command", cmdBuffer); 
          cmdBuffer = "";                  
          return;
        }

        
        if (domEvent.key === "Backspace") {
          
          if (cmdBuffer.length > 0) {
            cmdBuffer = cmdBuffer.slice(0, -1);
      
            term.write("\b \b");
          }
          return;
        }

      
        if (domEvent.ctrlKey && domEvent.key === "c") {
          term.write("^C\r\n");
          socket.emit("command", "\x03"); 
          cmdBuffer = "";
          return;
        }


        if (key.length === 1 && !domEvent.ctrlKey && !domEvent.metaKey) {
          cmdBuffer += key;
          term.write(key);
        }
      });

      // ============================
      // Optional: if you want raw passthrough mode (interactive),
      // add a toggle button that switches to passthrough:
      // - when enabled: send each keystroke directly: socket.emit("command", data)
      // - when disabled: use line-mode buffer above
      //
      // I can add this toggle UI if you want.
      // ============================
    </script>
  </body>
</html>
