<%- include('../partials/header.ejs') %>

<section>
  <h2>Dashboard</h2>
  <p>Welcome to your server management panel.</p>

  <% if (servers && servers.length > 0) { %>
    <ul>
      <% servers.forEach(server => { %>
        <li>
          <strong><%= server.name %></strong> — <%= server.status %> 
          (<%= server.instance_type %>, <%= server.region %>)

          <!-- delete button-->
          <form action="/servers/delete/<%= server.id %>" method="POST" style="display:inline;">
            <button type="submit">Delete</button>
          </form>

          <!-- servers details link-->
          <a href="/servers/<%= server.id %>">View</a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No servers found yet.</p>
  <% } %>
</section>

<%- include('../partials/footer.ejs') %>
